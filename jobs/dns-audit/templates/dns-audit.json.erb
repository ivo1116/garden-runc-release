<%=
  require 'json'

  window = p('dns_audit.dedup_window_seconds')
  rate = p('dns_audit.max_logs_per_second_per_container')
  ring = p('dns_audit.ring_buffer_size_kb')

  raise 'dns_audit.dedup_window_seconds must be greater than 0' unless window.is_a?(Integer) && window > 0
  raise 'dns_audit.max_logs_per_second_per_container must be greater than 0' unless rate.is_a?(Integer) && rate > 0
  raise 'dns_audit.ring_buffer_size_kb must be a power of two and at least 4' unless ring.is_a?(Integer) && ring >= 4 && (ring & (ring - 1)).zero?

  JSON.pretty_generate({
    'enabled' => p('dns_audit.enabled'),
    'cgroup_root' => '/sys/fs/cgroup/garden',
    'garden_network' => 'unix',
    'garden_address' => p('dns_audit.garden_socket'),
    'output_log_file' => '/var/vcap/sys/log/dns-audit/dns.log',
    'host_ip' => spec.ip,
    'host_id' => spec.id,
    'properties' => p('dns_audit.properties'),
    'dedup_window_seconds' => window,
    'max_logs_per_second_per_container' => rate,
    'exclude_domains' => p('dns_audit.exclude_domains'),
    'capture_responses' => p('dns_audit.capture_responses'),
    'ring_buffer_size_kb' => ring,
  })
%>
